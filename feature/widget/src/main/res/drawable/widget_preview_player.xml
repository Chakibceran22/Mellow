<?xml version="1.0" encoding="utf-8"?>
<!-- A still picture of the player widget for the phone's list of widgets, for launchers
     that do not lay out the real thing there (every one before Android 12, some after).
     It is the bar layout redrawn in shapes, with bars where the words go. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="300dp"
        android:height="72dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:width="52dp"
        android:height="52dp"
        android:drawable="@drawable/widget_sample_cover"
        android:gravity="start|center_vertical"
        android:start="10dp" />
    <!-- The title, a little above the middle. -->
    <item
        android:width="76dp"
        android:height="9dp"
        android:bottom="16dp"
        android:gravity="start|center_vertical"
        android:start="74dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_ink" />
            <corners android:radius="4.5dp" />
        </shape>
    </item>
    <!-- The artist, a little below it. -->
    <item
        android:width="48dp"
        android:height="7dp"
        android:gravity="start|center_vertical"
        android:start="74dp"
        android:top="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_ink_muted" />
            <corners android:radius="3.5dp" />
        </shape>
    </item>
    <item
        android:width="22dp"
        android:height="22dp"
        android:drawable="@drawable/widget_preview_previous"
        android:end="109dp"
        android:gravity="end|center_vertical" />
    <item
        android:width="40dp"
        android:height="40dp"
        android:end="54dp"
        android:gravity="end|center_vertical">
        <shape android:shape="oval">
            <solid android:color="@color/widget_accent" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/widget_preview_play"
        android:end="64dp"
        android:gravity="end|center_vertical" />
    <item
        android:width="22dp"
        android:height="22dp"
        android:drawable="@drawable/widget_preview_next"
        android:end="17dp"
        android:gravity="end|center_vertical" />
</layer-list>
