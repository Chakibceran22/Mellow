<?xml version="1.0" encoding="utf-8"?>
<!-- The play button: accent glass, as the main button on a screen of the app is. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_press_on_accent">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_accent" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_accent_edge" />
        </shape>
    </item>
</ripple>
