<?xml version="1.0" encoding="utf-8"?>
<!-- Square or tall: the cover fills the widget to its edges, and the song sits in a strip
     of glass below it. The rim of the glass runs over the cover too, so the picture reads
     as set into the pane.

     Before Android 12 a widget cannot cut its contents to its own rounded shape, so the
     picture arrives already cut: sized to this space, its top corners rounded
     (WidgetCovers), and is stretched to fit exactly. layout-v31 has the newer way. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:theme="@style/WidgetTone"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_sample_cover_full" />

        <include layout="@layout/widget_band" />
    </LinearLayout>

    <!-- The light on the rim of the glass, laid over everything. A picture made to this
         widget's size (WidgetGlass), coloured here so that it follows the phone's theme. -->
    <ImageView
        android:id="@+id/widget_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:tint="?attr/widgetShine" />
</FrameLayout>
